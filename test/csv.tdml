<?xml version="1.0" encoding="UTF-8"?>

<testSuite
  xmlns="http://www.ibm.com/xmlns/dfdl/testData"
  xmlns:tdml="http://www.ibm.com/xmlns/dfdl/testData"
  xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/" 
  xmlns:daf="urn:ogf:dfdl:2013:imp:daffodil.apache.org:2018:ext"
  defaultRoundTrip="onePass"
  defaultConfig="csv.cfg.xml">


  <!-- 
    Test name: csv_test
       Schema: csv.dfdl.xsd
         Root: file
      Purpose: This test is to exercise the csv schema.
  -->
  
  <parserTestCase name="csv_test" root="file"
    model="csv.dfdl.xsd" description="csv test"
    implementations="ibm daffodil">
    <document>
      <documentPart type="file">simpleCSV.csv</documentPart>
    </document>
    <infoset>
      <dfdlInfoset type="file">simpleCSV.xml</dfdlInfoset>
    </infoset>
  </parserTestCase>
  
  <!--
    Test name: csv_test_2
       Schema: csv.dfdl.xsd
         Root: file
      Purpose: This test is to exercise the csv schema with an incorrect matching 
               of header title number with element number.
  -->
  
  <parserTestCase name="csv_test_2" root="file"
    model="csvHeaderEnforced.dfdl.xsd" description="csv test"
    implementations="daffodil">
    <document><![CDATA[last,first,middle,DOB
baratheon,robert,brandon,1988-03-24,extra,extra
johnson,john,henry,1986-01-23
stark,arya,cat,1986-02-19
]]></document>
    <errors>
      <error>Parse Error</error>
      <error>Found</error>
      <error>delimiter</error>
    </errors>
  </parserTestCase>
  
  <parserTestCase name="csv_test_3" root="file"
    model="csvHeaderEnforced.dfdl.xsd" description="csv test"
    implementations="daffodil">
    <document><![CDATA[last,first,middle,DOB
johnson,john,henry
]]></document>
    <errors>
      <error>Parse Error</error>
      <error>Found</error>
      <error>delimiter</error>
    </errors>
  </parserTestCase>

  <!--
  This test is of Unicode with Kanji Characters.

  For the sake of non Japanese readers, here's the romanization of the
  names in this small test.
| Last  | First   | Middle  | Date-of-Birth | Romanized Name    |
| 山田   | 太郎    | 翔      | 1990-01-15    | Yamada Tarō Shō   |
| 佐藤   | 花子    | 美      | 1985-06-20    | Satō Hanako Mi    |
| 鈴木   | 一郎    | 直      | 1978-11-03    | Suzuki Ichirō Nao |
| 高橋   | 愛     | 裕      | 1995-03-10    | Takahashi Ai Yū   |
| 田中   | 健     | 大      | 1982-07-27    | Tanaka Ken Dai    |
  -->

  <parserTestCase name="unicode_csv_test" root="file"
                  model="csv.dfdl.xsd" description="unicode csv test"
                  implementations="ibm daffodil">
    <document>
      <documentPart type="file">kanjiCSV.csv</documentPart>
    </document>
    <infoset>
      <dfdlInfoset type="file">kanjiCSV.xml</dfdlInfoset>
    </infoset>
  </parserTestCase>
</testSuite>
